<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VSlices.Targets.DotNet.Refactor</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>

  <Target Name="PublishMSBuildWorkspaceBuildHosts" AfterTargets="Publish">
    <ItemGroup>
      <_NetCoreBuildHostFiles Include="$(TargetDir)BuildHost-netcore/**/*" />
      <_NetFrameworkBuildHostFiles Include="$(TargetDir)BuildHost-net472/**/*" />
    </ItemGroup>

    <Error
      Condition="'@(_NetCoreBuildHostFiles)' == ''"
      Text="Roslyn MSBuildWorkspace BuildHost-netcore was not produced in the companion output." />

    <Copy
      SourceFiles="@(_NetCoreBuildHostFiles)"
      DestinationFiles="@(_NetCoreBuildHostFiles->'$(PublishDir)BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Copy
      Condition="'@(_NetFrameworkBuildHostFiles)' != ''"
      SourceFiles="@(_NetFrameworkBuildHostFiles)"
      DestinationFiles="@(_NetFrameworkBuildHostFiles->'$(PublishDir)BuildHost-net472/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
