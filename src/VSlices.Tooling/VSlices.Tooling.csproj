<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>vslices</AssemblyName>
    <PublishAot>true</PublishAot>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vslices</ToolCommandName>
    <PackageId>VSlices.Tooling</PackageId>
    <Version>0.1.0-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Kokuban" Version="0.2.0" />
    <PackageReference Include="Kurukuru" Version="1.5.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ConsoleAppFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSlices.DocumentGeneration\VSlices.DocumentGeneration.csproj" />
    <ProjectReference Include="..\VSlices.Targets.DotNet\VSlices.Targets.DotNet.csproj" />
    <ProjectReference Include="..\VSlices.Vsir\VSlices.Vsir.csproj" />
    <ProjectReference Include="..\VSlices.Vsir.CSharp\VSlices.Vsir.CSharp.csproj" />
  </ItemGroup>

  <Target Name="PublishSemanticRefactoringHelper" AfterTargets="Publish">
    <PropertyGroup>
      <SemanticRefactoringPublishDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(PublishDir)refactor'))))</SemanticRefactoringPublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="..\VSlices.Targets.DotNet.Refactor\VSlices.Targets.DotNet.Refactor.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);PublishDir=$(SemanticRefactoringPublishDir);SelfContained=false;RuntimeIdentifier=" />
    <Error
      Condition="!Exists('$(SemanticRefactoringPublishDir)VSlices.Targets.DotNet.Refactor.dll')"
      Text="Roslyn semantic-refactoring companion helper was not published." />
    <Error
      Condition="!Exists('$(SemanticRefactoringPublishDir)BuildHost-netcore/Microsoft.CodeAnalysis.Workspaces.MSBuild.BuildHost.dll')"
      Text="Roslyn MSBuildWorkspace BuildHost-netcore runtime was not published." />
  </Target>

</Project>